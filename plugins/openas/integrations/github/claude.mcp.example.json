{
  "mcpServers": {
    "github": {
      "type": "stdio",
      "command": "github-mcp-server",
      "args": [
        "stdio",
        "--read-only",
        "--toolsets",
        "repos,issues,pull_requests,actions"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${OPENAS_GITHUB_TOKEN}"
      }
    }
  }
}
